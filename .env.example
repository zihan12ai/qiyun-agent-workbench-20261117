# demo: deterministic offline walkthrough; codex: real CLI, no automatic fallback
AGENT_MODE=demo
PORT=3100
HOST=127.0.0.1
# Required only for AGENT_MODE=codex. Never commit real credentials.
CODEX_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Replace with a model actually available to your API account/exam platform.
CODEX_MODEL=
CODEX_BIN=codex
RUN_TIMEOUT_MS=600000
MAX_CONCURRENT_RUNS=2

# Docker host port; change if the default port is occupied.
WORKBENCH_PORT=3100
